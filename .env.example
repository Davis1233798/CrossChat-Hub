HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./data/crosschat.sqlite
ADMIN_API_KEY=REPLACE_WITH_32_BYTES_RANDOM_HEX
ENCRYPTION_KEY=REPLACE_WITH_32_BYTES_RANDOM_HEX
WEBHOOK_BASE_URL=https://your-public-domain.example
OUTBOX_INTERVAL_MS=2000

# OAuth (Optional): register the exact /oauth/<platform>/callback URI with provider.
# Desktop default: http://127.0.0.1:8787. Some providers may require HTTPS/public callback.
OAUTH_CALLBACK_BASE_URL=http://127.0.0.1:8787
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_OAUTH_SCOPES=chat:write,im:write,channels:history
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

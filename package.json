{
  "name": "crosschat-hub",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "An auditable multi-platform messaging hub with cross-platform mention notifications",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node --env-file=.env --experimental-sqlite src/server.mjs",
    "dev": "node --env-file=.env --experimental-sqlite --watch src/server.mjs",
    "test": "node --experimental-sqlite --test test/*.test.mjs",
    "check": "node --check src/server.mjs && node --check src/runtime.mjs && node --check src/app.mjs && node --check src/bridge.mjs && node --check src/store.mjs && node --check src/oauth.mjs && node --check src/gateway.mjs && node --check desktop/main.cjs && node --check desktop/preload.cjs && node --check public/app.js",
    "desktop": "electron .",
    "desktop:win": "electron-builder --win",
    "desktop:mac": "electron-builder --mac",
    "desktop:dir": "electron-builder --dir"
  },
  "license": "MIT",
  "main": "desktop/main.cjs",
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "dev.crosschat.hub",
    "productName": "CrossChat Hub",
    "files": [
      "desktop/**/*",
      "src/**/*",
      "public/**/*",
      "package.json",
      "LICENSE",
      "README.md"
    ],
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "CrossChat-Hub-${version}-${os}-${arch}.${ext}"
  }
}

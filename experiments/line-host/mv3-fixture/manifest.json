{
  "manifest_version": 3,
  "name": "CrossChat LINE host capability fixture",
  "version": "0.1.0",
  "description": "Synthetic host diagnostics; no accounts, messages or LINE code.",
  "permissions": [
    "storage",
    "notifications",
    "downloads",
    "cookies",
    "system.display"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open host diagnostic"
  },
  "key": ""
}
